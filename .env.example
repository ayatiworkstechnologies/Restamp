# Safe placeholders only — never commit real values here.
# Copy to `.env.local` (gitignored) and adjust for local development.
#
# Local FastAPI backend (used automatically when unset in `expo start`,
# but explicit is better, e.g. a LAN IP for on-device testing):
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
# Google sign-in client id (public identifier, not a secret):
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
# Demo OTP mode: keep 0 unless doing local login demos:
EXPO_PUBLIC_OTP_DEMO_MODE=0
