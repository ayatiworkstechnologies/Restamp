# RESTAMP MOBILE APP environment (Expo). Placeholders only.
# EXPO_PUBLIC_* values are compiled into the app bundle and are PUBLIC:
# never put backend secrets here (JWT secret, database URL, API keys).
# OTP needs no app setting: the backend generates and verifies every code.
# When the backend runs with RESTAMP_OTP_DISPLAY_MODE=1 (local development
# only), the login screen shows the code it returns; production never does.

# =============================================================================
# PART 1: LOCAL DEVELOPMENT (copy to .env.local, which is gitignored)
# =============================================================================
# Backend base URL. Unset: http://127.0.0.1:8000 in `expo start`. For a phone
# on the same Wi-Fi, use this computer's LAN IP, e.g. http://192.168.1.20:8000
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
# Google sign-in client id for the web build (public identifier, not a secret).
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
# Reva chat endpoint. Unset: <EXPO_PUBLIC_API_URL>/chat.
EXPO_PUBLIC_CHAT_API_URL=

# =============================================================================
# PART 2: PRODUCTION BUILDS (EAS / web export). Set in the build environment.
# =============================================================================
# EXPO_PUBLIC_API_URL=https://api.restamp.in      # also the default when unset
# EXPO_PUBLIC_GOOGLE_CLIENT_ID=<real web client id>
# EXPO_PUBLIC_CHAT_API_URL=                       # leave unset to use <API>/chat
